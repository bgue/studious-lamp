{
    "$defs": {
        "Any": {
            "additionalProperties": true,
            "description": "Any JSON value. Used with `tl:json` for slots stored as JSON columns.",
            "title": "Any",
            "type": [
                "null",
                "boolean",
                "object",
                "number",
                "string"
            ]
        },
        "ConformanceStatus": {
            "description": "Result of evaluating a record against its effective schema (brief 6.3).",
            "enum": [
                "ok",
                "warning",
                "nonconformant",
                "waived"
            ],
            "title": "ConformanceStatus",
            "type": "string"
        },
        "Event": {
            "additionalProperties": false,
            "description": "One immutable ledger event.",
            "properties": {
                "actor": {
                    "description": "`user:<id>`, `svc:<name>` or `agent:<id>`.",
                    "type": "string"
                },
                "causation_id": {
                    "description": "Identifier of the event or command that caused this one; may be null.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "correlation_id": {
                    "description": "Ties a command chain, import, or automated process together.",
                    "type": "string"
                },
                "effective_at": {
                    "description": "Business (valid) time.",
                    "format": "date-time",
                    "type": "string"
                },
                "event_id": {
                    "description": "Unique event identifier (ULID).",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "event_type": {
                    "description": "`<Class>.<PastTenseVerb>`, for example `Record.Created`.",
                    "type": "string"
                },
                "hash": {
                    "description": "Hash of this event chained to `prev_hash`.",
                    "type": "string"
                },
                "payload": {
                    "$ref": "#/$defs/Any",
                    "description": "Event payload, a JSON object validated against the event type's schema."
                },
                "prev_hash": {
                    "description": "Hash of the previous event in the same scope; null for the first.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "recorded_at": {
                    "description": "System (transaction) time.",
                    "format": "date-time",
                    "type": "string"
                },
                "schema_version": {
                    "description": "Version of the event payload schema, for upcasting.",
                    "type": "integer"
                },
                "scope": {
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "seq": {
                    "description": "Global monotonic sequence; the ordering backbone.",
                    "type": "integer"
                },
                "source": {
                    "description": "`tui`, `api`, `mcp:<agent>`, `cli`, `import:<job>` or `sim:<run>`.",
                    "type": "string"
                },
                "stream_id": {
                    "description": "The record (aggregate) the event belongs to.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "stream_type": {
                    "description": "Record type of the stream, for example `core.Record`.",
                    "type": "string"
                },
                "stream_version": {
                    "description": "Per-stream version, used for optimistic concurrency.",
                    "type": "integer"
                }
            },
            "required": [
                "seq",
                "event_id",
                "stream_id",
                "stream_type",
                "stream_version",
                "event_type",
                "schema_version",
                "scope",
                "payload",
                "actor",
                "recorded_at",
                "effective_at",
                "correlation_id",
                "source",
                "hash"
            ],
            "title": "Event",
            "type": "object"
        },
        "Link": {
            "additionalProperties": false,
            "description": "One link between two records, in its current lifecycle state.",
            "properties": {
                "confidence": {
                    "description": "Confidence of a suggested link, between 0 and 1.",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "created_at": {
                    "description": "Time of the creating event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "created_by": {
                    "description": "Actor of the creating event.",
                    "type": "string"
                },
                "declined": {
                    "description": "True when the link was a suggestion that a person declined. Declines are remembered.",
                    "type": "boolean"
                },
                "from_id": {
                    "description": "The record the link starts at (the subject of the relation).",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "last_seq": {
                    "description": "Ledger `seq` of the last event applied.",
                    "type": "integer"
                },
                "link_id": {
                    "description": "Immutable link identifier; equals the ledger `stream_id` of the link.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "note": {
                    "description": "Optional free text.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "pin": {
                    "description": "Revision the link is pinned to; null means floating to the current revision.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason": {
                    "description": "Reason given with the last flag, decline, or retraction.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "relation": {
                    "description": "Forward relation code, for example `raised_against`.",
                    "type": "string"
                },
                "scope": {
                    "description": "Scope of the link, which is the scope of its `from` record.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "source": {
                    "$ref": "#/$defs/LinkSource",
                    "description": "How the link was created."
                },
                "status": {
                    "$ref": "#/$defs/LinkStatus",
                    "description": "Lifecycle state."
                },
                "to_id": {
                    "description": "The record the link points to.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Time of the last applied event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "verified_at": {
                    "description": "Time of the last `Link.Verified` event.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "verified_by": {
                    "description": "Actor of the last `Link.Verified` event.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "version": {
                    "description": "Ledger `stream_version` of the last event applied.",
                    "type": "integer"
                }
            },
            "required": [
                "link_id",
                "scope",
                "from_id",
                "to_id",
                "relation",
                "status",
                "source",
                "declined",
                "created_by",
                "created_at",
                "updated_at",
                "version",
                "last_seq"
            ],
            "title": "Link",
            "type": "object"
        },
        "LinkCount": {
            "additionalProperties": false,
            "description": "Per-record link counts, maintained with `cur_links` (brief 7.4).",
            "properties": {
                "active_in": {
                    "description": "Active links that point to the record.",
                    "type": "integer"
                },
                "active_out": {
                    "description": "Active links that start at the record.",
                    "type": "integer"
                },
                "broken": {
                    "description": "Broken links in either direction.",
                    "type": "integer"
                },
                "last_seq": {
                    "description": "Ledger `seq` of the last event that touched the counts.",
                    "type": "integer"
                },
                "record_id": {
                    "description": "The record the counts belong to.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "scope": {
                    "description": "Scope of the record.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "stale": {
                    "description": "Stale links in either direction.",
                    "type": "integer"
                },
                "suggested": {
                    "description": "Suggested links in either direction.",
                    "type": "integer"
                }
            },
            "required": [
                "record_id",
                "scope",
                "active_out",
                "active_in",
                "stale",
                "broken",
                "suggested",
                "last_seq"
            ],
            "title": "LinkCount",
            "type": "object"
        },
        "LinkRelation": {
            "description": "Built-in relation codes (brief 7.1). Documentation only: the vocabulary is extensible, so link rows store the code as a string.",
            "enum": [
                "references",
                "derived_from",
                "supersedes",
                "responds_to",
                "raised_against",
                "resolves",
                "belongs_to",
                "requires",
                "blocks",
                "verifies",
                "dispatched_from",
                "attached_to",
                "same_as"
            ],
            "title": "LinkRelation",
            "type": "string"
        },
        "LinkSource": {
            "description": "How a link came to exist (brief 7.1).",
            "enum": [
                "manual",
                "key_detected",
                "tray",
                "bulk",
                "model_selection",
                "thread_dispatch",
                "rule",
                "enricher",
                "import",
                "mapping"
            ],
            "title": "LinkSource",
            "type": "string"
        },
        "LinkStatus": {
            "description": "Lifecycle state of a link (brief 7.1).",
            "enum": [
                "suggested",
                "active",
                "stale",
                "broken",
                "retracted"
            ],
            "title": "LinkStatus",
            "type": "string"
        },
        "NumberingCounter": {
            "additionalProperties": false,
            "description": "The last sequence number allocated for one counter.",
            "properties": {
                "allocations": {
                    "description": "Number of allocations made from this counter.",
                    "type": "integer"
                },
                "counter_id": {
                    "description": "Ledger stream id of the counter, `numbering:<scope>:<pattern>:<prefix>`.",
                    "type": "string"
                },
                "last_key": {
                    "description": "The key built from `last_sequence`.",
                    "type": "string"
                },
                "last_record_id": {
                    "description": "The record the last number was allocated for; null for a standalone allocation.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "last_seq": {
                    "description": "Ledger `seq` of the last allocation.",
                    "type": "integer"
                },
                "last_sequence": {
                    "description": "The highest sequence number allocated so far.",
                    "type": "integer"
                },
                "pattern": {
                    "description": "Identifier of the numbering pattern.",
                    "type": "string"
                },
                "prefix": {
                    "description": "The rendered key without its sequence number, for example `P123-REC-`.",
                    "type": "string"
                },
                "scope": {
                    "description": "Scope the counter belongs to.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Time of the last allocation (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "version": {
                    "description": "Ledger `stream_version` of the counter after the last allocation.",
                    "type": "integer"
                }
            },
            "required": [
                "counter_id",
                "scope",
                "pattern",
                "prefix",
                "last_sequence",
                "last_key",
                "allocations",
                "version",
                "last_seq",
                "updated_at"
            ],
            "title": "NumberingCounter",
            "type": "object"
        },
        "PsetLayer": {
            "description": "Layer a pset value belongs to (brief 6.3).",
            "enum": [
                "standard",
                "custom",
                "project",
                "enrichment",
                "source"
            ],
            "title": "PsetLayer",
            "type": "string"
        },
        "PsetValue": {
            "additionalProperties": false,
            "description": "One current pset value of one record, addressed by its layer-aware path.",
            "properties": {
                "last_seq": {
                    "description": "Ledger `seq` of the event that last set the row.",
                    "type": "integer"
                },
                "layer": {
                    "$ref": "#/$defs/PsetLayer",
                    "description": "Layer derived from the path."
                },
                "path": {
                    "description": "Layer-aware path, for example `psets.valve_data.x.fat_witness_by`.",
                    "type": "string"
                },
                "property_name": {
                    "description": "Property relative to the pset; custom-section properties start with `x.`.",
                    "type": "string"
                },
                "pset": {
                    "description": "Pset name, for example `valve_data` or `prj.shutdown_tie_in`.",
                    "type": "string"
                },
                "record_id": {
                    "description": "The record (ledger stream) the value belongs to.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "scope": {
                    "description": "Scope of the record, repeated so scope-wide filters need no join.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "unit": {
                    "description": "UCUM unit recorded with the value, when the schema declared one.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "updated_at": {
                    "description": "Timestamp of that event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "value_bool": {
                    "description": "Boolean values.",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "value_json": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Lists and other structured values."
                },
                "value_num": {
                    "description": "Integer and decimal values.",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "value_text": {
                    "description": "String values.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "value_type": {
                    "$ref": "#/$defs/PsetValueType",
                    "description": "Which of the typed value columns is set."
                }
            },
            "required": [
                "record_id",
                "scope",
                "path",
                "pset",
                "property_name",
                "layer",
                "value_type",
                "last_seq",
                "updated_at"
            ],
            "title": "PsetValue",
            "type": "object"
        },
        "PsetValueType": {
            "description": "Which typed value column holds the value.",
            "enum": [
                "string",
                "number",
                "boolean",
                "json"
            ],
            "title": "PsetValueType",
            "type": "string"
        },
        "Record": {
            "additionalProperties": false,
            "description": "The generic Phase 0 record type, `core.Record`.",
            "properties": {
                "conformance": {
                    "$ref": "#/$defs/ConformanceStatus",
                    "description": "Conformance of the current values to the effective schema."
                },
                "created_at": {
                    "description": "Timestamp of the creating event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "description": {
                    "description": "Longer free-text description.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "effective_schema_hash": {
                    "description": "Hash of the effective schema in force at the last write; null before Increment 2.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "Immutable global identifier; equals the ledger `stream_id`.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "key": {
                    "description": "Human-readable number, unique within a scope. Null until numbering assigns one.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "last_seq": {
                    "description": "Ledger `seq` of the last event applied.",
                    "type": "integer"
                },
                "psets": {
                    "$ref": "#/$defs/Any",
                    "description": "Property-set values keyed by pset name, stored as a JSON object."
                },
                "scope": {
                    "description": "`company` or `project:<id>`.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "status": {
                    "description": "Workflow state; null when the record type has no workflow.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "Short human-readable title.",
                    "type": "string"
                },
                "type": {
                    "description": "Fully qualified record type, for example `core.Record`.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Timestamp of the last applied event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "version": {
                    "description": "Ledger `stream_version` of the last event applied.",
                    "type": "integer"
                },
                "voided": {
                    "description": "Set by `Record.Voided`. Voided rows are never deleted.",
                    "type": "boolean"
                }
            },
            "required": [
                "id",
                "type",
                "scope",
                "title",
                "psets",
                "voided",
                "version",
                "last_seq",
                "conformance",
                "created_at",
                "updated_at"
            ],
            "title": "Record",
            "type": "object"
        },
        "RecordEnvelope": {
            "additionalProperties": false,
            "description": "Fields every record type shares (brief 6.2). Mixed into each concrete record class.",
            "properties": {
                "conformance": {
                    "$ref": "#/$defs/ConformanceStatus",
                    "description": "Conformance of the current values to the effective schema."
                },
                "created_at": {
                    "description": "Timestamp of the creating event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "description": {
                    "description": "Longer free-text description.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "effective_schema_hash": {
                    "description": "Hash of the effective schema in force at the last write; null before Increment 2.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "Immutable global identifier; equals the ledger `stream_id`.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "key": {
                    "description": "Human-readable number, unique within a scope. Null until numbering assigns one.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "last_seq": {
                    "description": "Ledger `seq` of the last event applied.",
                    "type": "integer"
                },
                "psets": {
                    "$ref": "#/$defs/Any",
                    "description": "Property-set values keyed by pset name, stored as a JSON object."
                },
                "scope": {
                    "description": "`company` or `project:<id>`.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "status": {
                    "description": "Workflow state; null when the record type has no workflow.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "Short human-readable title.",
                    "type": "string"
                },
                "type": {
                    "description": "Fully qualified record type, for example `core.Record`.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Timestamp of the last applied event (system time).",
                    "format": "date-time",
                    "type": "string"
                },
                "version": {
                    "description": "Ledger `stream_version` of the last event applied.",
                    "type": "integer"
                },
                "voided": {
                    "description": "Set by `Record.Voided`. Voided rows are never deleted.",
                    "type": "boolean"
                }
            },
            "required": [
                "id",
                "type",
                "scope",
                "title",
                "psets",
                "voided",
                "version",
                "last_seq",
                "conformance",
                "created_at",
                "updated_at"
            ],
            "title": "RecordEnvelope",
            "type": "object"
        },
        "WorkflowState": {
            "additionalProperties": false,
            "description": "The state a record is in, since when, and by which transition it got there.",
            "properties": {
                "entered_at": {
                    "description": "When the record entered the state (`state_entered_at`).",
                    "format": "date-time",
                    "type": "string"
                },
                "last_seq": {
                    "description": "Ledger `seq` of the transition event.",
                    "type": "integer"
                },
                "record_id": {
                    "description": "The record (ledger stream) the state belongs to.",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "type": "string"
                },
                "scope": {
                    "description": "Scope of the record.",
                    "pattern": "^(company|project:[A-Za-z0-9_.-]+)$",
                    "type": "string"
                },
                "state": {
                    "description": "Current state name.",
                    "type": "string"
                },
                "transition": {
                    "description": "Name of the transition that led here.",
                    "type": "string"
                },
                "transitioned_by": {
                    "description": "Actor of the transition.",
                    "type": "string"
                },
                "workflow": {
                    "description": "Identifier of the workflow definition, for example `core.review`.",
                    "type": "string"
                },
                "workflow_version": {
                    "description": "Version of the workflow definition that was in force.",
                    "type": "integer"
                }
            },
            "required": [
                "record_id",
                "scope",
                "workflow",
                "workflow_version",
                "state",
                "entered_at",
                "transition",
                "transitioned_by",
                "last_seq"
            ],
            "title": "WorkflowState",
            "type": "object"
        }
    },
    "$id": "https://example.org/throughline/core",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": true,
    "metamodel_version": "1.12.0",
    "title": "tl_core",
    "type": "object",
    "version": null
}
