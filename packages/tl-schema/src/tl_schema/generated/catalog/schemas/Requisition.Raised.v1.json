{
  "$id": "https://tl.example.com/schema/events/Requisition.Raised/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The CloudEvents 1.0 envelope (brief 18.3) used for webhooks, streams, the events API and exports. Extension attributes are lower-case as CloudEvents requires: `tlseq`, `tlstreamversion`, `tlcorrelationid`, `tlactor`.",
  "properties": {
    "data": {
      "additionalProperties": true,
      "description": "The `data` member of a webhook CloudEvent.",
      "properties": {
        "changes": {
          "description": "Delta and full modes. Object of field path to `[old, new]`; `old` is null when the event does not carry it."
        },
        "detail": {
          "additionalProperties": true,
          "description": "Delta and full modes. The ledger event payload, described per event type in the catalog.",
          "properties": {
            "at": {
              "description": "UTC time the fact happened; null means the time it was recorded (valid time, ADR-0026).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "classification": {
              "description": "Labour: the classification, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "craft": {
              "description": "Labour: the craft.",
              "type": [
                "string",
                "null"
              ]
            },
            "duration_days": {
              "description": "Scaffold: 1 to 1000.",
              "type": [
                "integer",
                "null"
              ]
            },
            "elevation": {
              "description": "Scaffold: elevation, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "end_date": {
              "description": "Labour: YYYY-MM-DD.",
              "type": [
                "string",
                "null"
              ]
            },
            "for_record_id": {
              "description": "The IWP or CWP the request serves, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "from_location_id": {
              "description": "Material: the location to issue from, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "general_type": {
              "description": "General: code of the code list GeneralRequisitionType.",
              "type": [
                "string",
                "null"
              ]
            },
            "gridline": {
              "description": "Scaffold: gridline, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "headcount": {
              "description": "Labour: people wanted, 1 to 500.",
              "type": [
                "integer",
                "null"
              ]
            },
            "height_m": {
              "description": "Scaffold: decimal text, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "description": "labor, material, general or scaffold.",
              "enum": [
                "labor",
                "material",
                "general",
                "scaffold"
              ],
              "title": "RequisitionKind",
              "type": "string"
            },
            "length_m": {
              "description": "Scaffold: decimal text, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "lines": {
              "description": "Material: list of lines {item_id, qty, uom, cost_code_id, fulfilled_qty}; quantities are decimal text."
            },
            "load_class": {
              "description": "Scaffold: load class, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "location_text": {
              "description": "Where, in words, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "need_by": {
              "description": "YYYY-MM-DD, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "priority": {
              "description": "low, normal, high or urgent.",
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ],
              "title": "RequisitionPriority",
              "type": "string"
            },
            "purpose": {
              "description": "Scaffold: what it is for.",
              "type": [
                "string",
                "null"
              ]
            },
            "requester": {
              "description": "Actor text of the requester.",
              "type": "string"
            },
            "requirements": {
              "description": "Labour: special requirements, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "shift": {
              "description": "Labour: the shift, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "start_date": {
              "description": "Labour: YYYY-MM-DD.",
              "type": [
                "string",
                "null"
              ]
            },
            "subject": {
              "description": "What is asked for.",
              "type": "string"
            },
            "width_m": {
              "description": "Scaffold: decimal text, or null.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "subject",
            "requester",
            "priority"
          ],
          "title": "RequisitionRaisedPayload",
          "type": "object"
        },
        "links": {
          "description": "Delta and full modes. Immediate links.",
          "items": {
            "additionalProperties": false,
            "description": "One immediate link of the origin record (delta mode).",
            "properties": {
              "id": {
                "description": "`urn:tl:<ulid>` of the record at the other end.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rel": {
                "type": "string"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "rel"
            ],
            "title": "EventLinkRef",
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "origin": {
          "additionalProperties": false,
          "description": "Pointer to the originating record at the version of the event (brief 18.3, `RecordRef`).",
          "properties": {
            "api": {
              "description": "API URL of the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "`urn:tl:<ulid>` of the record.",
              "type": "string"
            },
            "key": {
              "description": "Human-readable key.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "description": "Record type.",
              "type": [
                "string",
                "null"
              ]
            },
            "uri": {
              "description": "Resolvable URI of the record at this version (`...@v7`).",
              "type": "string"
            },
            "version": {
              "description": "Version of the record after the event.",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "uri",
            "version"
          ],
          "title": "EventOrigin",
          "type": "object"
        },
        "record": {
          "description": "Full mode only. The record projection as of delivery preparation, with its `version`."
        }
      },
      "required": [
        "origin"
      ],
      "title": "CloudEventData",
      "type": "object"
    },
    "datacontenttype": {
      "const": "application/json",
      "type": "string"
    },
    "dataschema": {
      "const": "https://tl.example.com/schema/events/Requisition.Raised/1",
      "description": "URI of the catalog schema of this event type.",
      "type": "string"
    },
    "id": {
      "description": "The ledger event id. Receivers dedupe on it.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "source": {
      "description": "URI of the company and project the event came from.",
      "type": "string"
    },
    "specversion": {
      "const": "1.0",
      "type": "string"
    },
    "subject": {
      "description": "`urn:tl:<ulid>` of the subject record, the ordering key.",
      "type": "string"
    },
    "time": {
      "description": "When the ledger committed the event (UTC).",
      "format": "date-time",
      "type": "string"
    },
    "tlactor": {
      "type": "string"
    },
    "tlcorrelationid": {
      "type": "string"
    },
    "tlseq": {
      "description": "Ledger `seq`.",
      "type": "integer"
    },
    "tlstreamversion": {
      "description": "Version within the event's stream.",
      "type": "integer"
    },
    "type": {
      "const": "tl.core.Requisition.Raised.v1",
      "description": "`tl.<module>.<Class>.<Verb>.v<schema version>`, for example `tl.core.Record.Created.v1`.",
      "pattern": "^tl\\.[A-Za-z0-9_]+\\.[A-Za-z0-9_]+\\.[A-Za-z0-9_]+\\.v[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "subject",
    "dataschema",
    "datacontenttype",
    "tlseq",
    "tlstreamversion",
    "tlcorrelationid",
    "tlactor",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
