{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:throughline:document-schema:instrument-index:1.0.0",
  "title": "Instrument index",
  "description": "One row per engineering tag of an instrument index: the tag number, its class, the service and, for valves, the valve data.",
  "type": "object",
  "required": [
    "tag_number",
    "tag_class",
    "service"
  ],
  "additionalProperties": false,
  "properties": {
    "tag_number": {
      "type": "string",
      "description": "Engineering tag number: area, mnemonic and a four-digit sequence, for example 47-FV-1001 (the Acme tag pattern).",
      "pattern": "^[0-9]{2}-[A-Z]{1,4}-[0-9]{4}$",
      "maxLength": 40
    },
    "tag_class": {
      "type": "string",
      "description": "Tag class from the Acme standards.",
      "enum": [
        "ControlValve",
        "ManualValve",
        "SafetyValve",
        "Transmitter",
        "Controller",
        "Pump",
        "Vessel",
        "HeatExchanger",
        "Compressor",
        "Motor"
      ]
    },
    "service": {
      "type": "string",
      "description": "What the tagged item does, for example Feed gas flow control.",
      "minLength": 1,
      "maxLength": 200
    },
    "area": {
      "type": "string",
      "description": "Plant area (unit number) of the tag; when present it is the first segment of the tag number.",
      "pattern": "^[0-9]{2}$"
    },
    "p_and_id": {
      "type": "string",
      "description": "Drawing number of the P&ID the tag appears on.",
      "maxLength": 40
    },
    "size_in": {
      "type": "string",
      "description": "Valve nominal size in inches.",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "maxLength": 10,
      "x-tl-type": "decimal"
    },
    "body_material": {
      "type": "string",
      "description": "Valve body material code.",
      "enum": [
        "CS",
        "SS304",
        "SS316L",
        "DUPLEX",
        "other"
      ]
    },
    "manufacturer": {
      "type": "string",
      "description": "Valve manufacturer.",
      "maxLength": 100
    },
    "fail_action": {
      "type": "string",
      "description": "Actuator position on loss of signal or air: FC fail closed, FO fail open, FL fail last.",
      "enum": [
        "FC",
        "FO",
        "FL"
      ]
    },
    "remarks": {
      "type": "string",
      "description": "Free text.",
      "maxLength": 500
    }
  },
  "x-throughline": {
    "code": "instrument-index",
    "version": "1.0.0",
    "title": "Instrument index",
    "target": {
      "module": "engineering",
      "record_type": "engineering.Tag",
      "key": "tag_number",
      "title": "service",
      "class": "tag_class"
    },
    "unique": [
      "tag_number"
    ],
    "header_aliases": {
      "tag_number": [
        "TAG NO",
        "Tag No.",
        "Tag Number",
        "TAG"
      ],
      "tag_class": [
        "Class",
        "Tag Class",
        "TYPE"
      ],
      "service": [
        "Service",
        "Description",
        "SERVICE"
      ],
      "area": [
        "Area",
        "Unit"
      ],
      "p_and_id": [
        "P&ID",
        "PID",
        "P&ID No."
      ],
      "size_in": [
        "SIZE (IN)",
        "Size",
        "Size in"
      ],
      "body_material": [
        "MATERIAL",
        "Body Material"
      ],
      "manufacturer": [
        "MFR",
        "Manufacturer"
      ],
      "fail_action": [
        "FAIL",
        "Fail Action"
      ],
      "remarks": [
        "REMARKS",
        "Remarks",
        "Notes"
      ]
    },
    "sample": "instrument-index@1.0.0.sample.csv",
    "invalid_sample": "instrument-index@1.0.0.invalid.csv"
  }
}
